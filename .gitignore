# Build outputs
/vol
/vol.exe
*.test
*.out

# Test, coverage, and profiling artifacts
coverage.*
*.prof
*.pprof

# Local Go caches and workspaces
/.gocache/
go.work
go.work.sum

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local secrets
.env
.env.*
!.env.example

# bench/ — Python tooling artifacts (Go toolchain ignores .py files naturally)
bench/.venv/
bench/**/__pycache__/
bench/**/*.pyc
bench/.python-version
# LLM harness dry-run noise (commit live run artifacts deliberately)
bench/llm/results/*_dryrun_*.jsonl
bench/llm/results/*_dryrun_*.md
bench/llm/results/*.partial.jsonl
