// Return Result from helpers, then unwrap with if-let.

fn divide(a, b) {
    if b == 0 {
        return err("divide by zero")
    }
    return ok(a / b)
}

if ok n := divide(10, 2) {
    print "10/2 =", n
} else err msg {
    print "error:", msg
}

if ok n := divide(10, 0) {
    print "10/0 =", n
} else err msg {
    print "error:", msg
}
