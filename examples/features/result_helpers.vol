// Result from helpers: return ok(...) or err(...), then if-let.

fn divide(a, b) {
    if b == 0 {
        return err("divide by zero")
    }
    return ok(a / b)
}

if ok n := divide(10, 2) {
    print n
} else err msg {
    print msg
}

if ok n := divide(10, 0) {
    print n
} else err msg {
    print msg
}
