// Contact book: Option lookup with if-let and ??.

import "examples/projects/contacts/people"

book := [people.Contact { name: "Ada", email: "ada@example.com" }, people.Contact { name: "Grace", email: "grace@example.com" }]

if some c := people.find_by_name(book, "Ada") {
    print people.display(c)
} else {
    print "not found"
}

maybe := people.find_by_name(book, "Alan")
name := none
if some c := maybe {
    name = some(c.name)
} else {
    name = none
}
print name ?? "no contact named Alan"
