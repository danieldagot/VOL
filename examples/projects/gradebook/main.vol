// Classroom gradebook: structs, imports, .map / .count / .where.

import "examples/projects/gradebook/grades"

class := [Student { name: "Ada", score: 92 }, Student { name: "Grace", score: 88 }, Student { name: "Alan", score: 54 }, Student { name: "Katherine", score: 97 }]

print "Roster:", names_of(class)
print "Average:", average(class)
print "Passing:", passing_count(class)

high := class.where(_.score >= 90)
print "Honor roll:", names_of(high)
