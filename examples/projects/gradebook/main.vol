// Classroom gradebook: structs, imports, .map / .count / .where.

import "examples/projects/gradebook/grades"

class := [grades.Student { name: "Ada", score: 92 }, grades.Student { name: "Grace", score: 88 }, grades.Student { name: "Alan", score: 54 }, grades.Student { name: "Katherine", score: 97 }]

print "Roster:", grades.names_of(class)
print "Average:", grades.average(class)
print "Passing:", grades.passing_count(class)

high := class.where(_.score >= 90)
print "Honor roll:", grades.names_of(high)
