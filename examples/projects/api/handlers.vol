// HTTP route handlers over the notes store (SF-3.1 @std/http + @std/json + @std/strings).

export boot, handle

import "examples/projects/api/store"
import "@std/http"
import "@std/json"
import "@std/strings"

fn boot() {
    return store.init_store()
}

fn json_error(status, message) {
    return http.reply(status, dict { error: message })
}

fn list_handler() {
    rows := store.list_notes()?
    return http.reply(200, rows)
}

fn create_handler(req) {
    data := json.parse(req.body)?
    note := store.add_note(data["title"])?
    return http.reply(201, note)
}

fn get_handler(id) {
    if ok note := store.get_note(id) {
        return http.reply(200, note)
    } else err e {
        return json_error(404, e)
    }
}

fn delete_handler(id) {
    if ok _ := store.remove_note(id) {
        return http.reply(200, dict { deleted: true })
    } else err e {
        return json_error(404, e)
    }
}

fn handle(req) {
    if req.method == "GET" and req.path == "/health" {
        return http.reply(200, dict { ok: true })
    }

    if req.path == "/notes" {
        if req.method == "GET" {
            return list_handler()
        }
        if req.method == "POST" {
            return create_handler(req)
        }
        return json_error(405, "method not allowed")
    }

    if strings.prefix(req.path, "/notes/") {
        parts := strings.split(req.path, "/")
        if parts.len != 3 {
            return json_error(404, "not found")
        }
        id := parts[2]
        if req.method == "GET" {
            return get_handler(id)
        }
        if req.method == "DELETE" {
            return delete_handler(id)
        }
        return json_error(405, "method not allowed")
    }

    return json_error(404, "not found")
}
