// Simple shop cart: Result checkout with if-let and postfix ?.

import "examples/projects/shop/cart"

fn pay(items) {
    amount := checkout(items)?
    return ok("charged " + amount)
}

cart := [Item { name: "mug", price: 12, qty: 2 }, Item { name: "sticker", price: 3, qty: 5 }]

print "Subtotal:", cart_total(cart)

if ok msg := pay(cart) {
    print "pay:", msg
} else err e {
    print "pay failed:", e
}

if ok msg := pay([]) {
    print "pay:", msg
} else err e {
    print "pay failed:", e
}
