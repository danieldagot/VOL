// Simple shop cart: Result checkout with if-let and postfix ?.

import "examples/projects/shop/cart"

fn pay(items) {
    amount := cart.checkout(items)?
    return ok("charged " + amount)
}

items := [cart.Item { name: "mug", price: 12, qty: 2 }, cart.Item { name: "sticker", price: 3, qty: 5 }]

print "Subtotal:", cart.cart_total(items)

if ok msg := pay(items) {
    print "pay:", msg
} else err e {
    print "pay failed:", e
}

if ok msg := pay([]) {
    print "pay:", msg
} else err e {
    print "pay failed:", e
}
