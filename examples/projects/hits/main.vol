// Tiny hits counter using @std/db + @std/env (SF-3.1).

import "@std/db"
import "@std/env"

fn bump() {
    path := env.get("HITS_DB") ?? ":memory:"
    conn := db.open(path)?
    db.exec(conn, "create table if not exists hits (n int)")?
    rows := db.query(conn, "select n from hits")?
    n := 0
    if rows.len > 0 {
        n = rows[0]["n"]
    }
    n = n + 1
    db.exec(conn, "delete from hits")?
    db.exec(conn, "insert into hits(n) values (?)", n)?
    db.close(conn)?
    return ok(n)
}

if ok n := bump() {
    print "hits:", n
} else err e {
    print "error:", e
}
