scores := [85, 72, 91, 60, 78, 95, 55, 68, 88, 74]

a_grades := scores.where(_ >= 90)
b_grades := scores.where(_ >= 80).where(_ < 90)
passing := scores.where(_ >= 60)
failing := scores.where(_ < 60)
avg := scores.sum / scores.len

print "Class average: " + string(avg)
print "A grades: " + string(a_grades.len)
print "B grades: " + string(b_grades.len)
print "Passing: " + string(passing.len)
print "Failing: " + string(failing.len)
